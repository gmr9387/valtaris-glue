// supabase/functions/stuck-run-detector/index.ts
// Valtaris Glue — Stuck Run Sweep (Generation 3)
//
// This file is responsible for:
//   - periodically scanning all "running" workflow_runs
//   - delegating detection + repair of each one to repair-stuck-run
//     (which does its own staleness checks and is explicitly designed
//     to be called by this function -- see its own header: "Called by
//     check-invariants, stuck-run-detector, SLA sweeper")
//
// Authority chain:
//   stuck-run-detector → repair-stuck-run → schedule-next-job
//
// This file NEVER:
//   - executes connectors
//   - repairs anything itself (always delegates to repair-stuck-run)
//   - mutates workflow_versions
//   - bypasses RLS
//
// Restored 2026-09-17: this file's deployed bytes were previously an
// exact copy of repair-run's source (confirmed via md5sum) -- a
// different, action-taking function with an incompatible request
// contract ({run_id, type, job_id, step_id}, not a no-body sweep) --
// so this cron-style sweep never actually ran and repair-stuck-run's
// real logic had no real caller feeding it besides check-invariants.

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const { data: runningRuns, error } = await supabase
      .from("workflow_runs")
      .select("id")
      .eq("state", "running");

    if (error) {
      console.error("stuck-run-detector load error:", error);
      return jsonError("load-failed", 500, error);
    }

    const checked: string[] = [];
    for (const run of runningRuns ?? []) {
      await supabase.functions.invoke("repair-stuck-run", {
        body: { run_id: run.id },
      });
      checked.push(run.id);
    }

    return jsonOK({
      status: "stuck-run-sweep-complete",
      runs_checked: checked.length,
      run_ids: checked,
    });
  } catch (err) {
    console.error("stuck-run-detector fatal error:", err);
    return jsonError("stuck-run-detector-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
