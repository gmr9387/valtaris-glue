// supabase/functions/check-invariants/index.ts
// Valtaris Glue — Invariant Detector (Generation 3)
//
// This file is responsible for:
//   - scanning for the violation types repair-run already knows how
//     to fix (see that file's own `type` switch) and dispatching to it
//   - read-only: never mutates state itself
//
// Authority chain:
//   check-invariants → repair-run → job-lifecycle / step-lifecycle / run-lifecycle
//
// This file NEVER:
//   - executes connectors
//   - creates jobs directly
//   - mutates workflow_versions
//   - repairs anything itself (always delegates to repair-run, which
//     is the sole owner of repair actions)
//
// Coverage: implements 6 of repair-run's 9 accepted repair types --
// expired-lease, run-running-with-no-active-jobs,
// run-completed-with-active-jobs, job-running-with-terminal-step,
// step-completed-with-noncompleted-job, missing-step-run. The other
// three (invalid-step-run, run-failed-without-compensation) need a
// definition of "invalid" / compensation-graph traversal that isn't
// evidenced anywhere in the real callers checked while writing this --
// left unimplemented rather than guessed at.
//
// Restored 2026-09-17: this file's deployed bytes were previously an
// exact copy of audit-run's source (confirmed via md5sum), so nothing
// ever actually scanned for or repaired stuck invariants -- repair-run
// existed with real repair logic but had no real caller feeding it.

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const violations: { run_id: string; type: string; job_id?: string; step_id?: string }[] = [];

    violations.push(...(await findExpiredLeases()));
    violations.push(...(await findRunsWithNoActiveJobs()));
    violations.push(...(await findTerminalRunsWithActiveJobs()));
    violations.push(...(await findJobsRunningWithTerminalStep()));
    violations.push(...(await findStepsCompletedWithNoncompletedJob()));
    violations.push(...(await findMissingStepRuns()));

    for (const v of violations) {
      await supabase.functions.invoke("repair-run", { body: v });
    }

    return jsonOK({
      status: "invariants-checked",
      violations_found: violations.length,
      violations,
    });
  } catch (err) {
    console.error("check-invariants fatal error:", err);
    return jsonError("check-invariants-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Detectors
// ------------------------------------------------------------

async function findExpiredLeases() {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("id, run_id")
    .eq("state", "running")
    .lt("lease_expires_at", new Date().toISOString());

  return (data ?? []).map((job: any) => ({
    run_id: job.run_id,
    type: "expired-lease",
    job_id: job.id,
  }));
}

async function findRunsWithNoActiveJobs() {
  const { data: runningRuns } = await supabase
    .from("workflow_runs")
    .select("id")
    .eq("state", "running");

  const out: { run_id: string; type: string }[] = [];
  for (const run of runningRuns ?? []) {
    const { count } = await supabase
      .from("workflow_jobs")
      .select("id", { count: "exact", head: true })
      .eq("run_id", run.id)
      .in("state", ["pending", "running", "retrying"]);
    if ((count ?? 0) === 0) {
      out.push({ run_id: run.id, type: "run-running-with-no-active-jobs" });
    }
  }
  return out;
}

async function findTerminalRunsWithActiveJobs() {
  const { data: terminalRuns } = await supabase
    .from("workflow_runs")
    .select("id")
    .in("state", ["completed", "failed"]);

  const out: { run_id: string; type: string }[] = [];
  for (const run of terminalRuns ?? []) {
    const { count } = await supabase
      .from("workflow_jobs")
      .select("id", { count: "exact", head: true })
      .eq("run_id", run.id)
      .in("state", ["pending", "running", "retrying"]);
    if ((count ?? 0) > 0) {
      out.push({ run_id: run.id, type: "run-completed-with-active-jobs" });
    }
  }
  return out;
}

async function findJobsRunningWithTerminalStep() {
  const { data: runningJobs } = await supabase
    .from("workflow_jobs")
    .select("id, run_id, step_id")
    .eq("state", "running");

  const out: { run_id: string; type: string; job_id: string; step_id: string }[] = [];
  for (const job of runningJobs ?? []) {
    const { data: step } = await supabase
      .from("workflow_step_runs")
      .select("state")
      .eq("run_id", job.run_id)
      .eq("step_id", job.step_id)
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (step && ["completed", "failed"].includes(step.state)) {
      out.push({
        run_id: job.run_id,
        type: "job-running-with-terminal-step",
        job_id: job.id,
        step_id: job.step_id,
      });
    }
  }
  return out;
}

async function findStepsCompletedWithNoncompletedJob() {
  const { data: completedSteps } = await supabase
    .from("workflow_step_runs")
    .select("run_id, step_id")
    .eq("state", "completed");

  const out: { run_id: string; type: string; step_id: string }[] = [];
  for (const step of completedSteps ?? []) {
    const { data: job } = await supabase
      .from("workflow_jobs")
      .select("state")
      .eq("run_id", step.run_id)
      .eq("step_id", step.step_id)
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (job && job.state !== "completed") {
      out.push({
        run_id: step.run_id,
        type: "step-completed-with-noncompleted-job",
        step_id: step.step_id,
      });
    }
  }
  return out;
}

async function findMissingStepRuns() {
  const { data: completedJobs } = await supabase
    .from("workflow_jobs")
    .select("id, run_id, step_id")
    .eq("state", "completed");

  const out: { run_id: string; type: string; job_id: string }[] = [];
  for (const job of completedJobs ?? []) {
    const { count } = await supabase
      .from("workflow_step_runs")
      .select("id", { count: "exact", head: true })
      .eq("run_id", job.run_id)
      .eq("step_id", job.step_id);

    if ((count ?? 0) === 0) {
      out.push({ run_id: job.run_id, type: "missing-step-run", job_id: job.id });
    }
  }
  return out;
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
