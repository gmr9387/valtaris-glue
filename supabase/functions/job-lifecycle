// supabase/functions/job-lifecycle/index.ts
// Valtaris Glue — Job Lifecycle Engine (Generation 3)
//
// This file is responsible for:
//   - transitioning workflow_jobs between states
//   - marking jobs completed / failed / retried / delayed / dead-lettered
//   - emitting job lifecycle events
//   - invoking step-lifecycle for step state transitions
//   - invoking schedule-next-job for DAG progression
//
// Authority chain:
//   run-worker → job-lifecycle → step-lifecycle → schedule-next-job
//
// This file NEVER:
//   - executes connectors
//   - mutates workflow_versions
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { computeBackoffMs } from "../_shared/retry-policy.pure.ts";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const NOW = () => new Date();

serve(async (req) => {
  try {
    const body = await req.json();
    const { job_id, action, result, error, delay_ms } = body;

    if (!job_id || !action) {
      return jsonError("missing-fields", 400);
    }

    const job = await loadJob(job_id);
    if (!job) return jsonError("job-not-found", 404);

    switch (action) {
      case "complete":
        await markCompleted(job, result);
        break;

      case "fail":
        await markFailed(job, error);
        break;

      case "retry":
        await markRetry(job, error);
        break;

      case "delay":
        await markDelayed(job, error, delay_ms);
        break;

      case "dead-letter":
        await markDeadLetter(job, error);
        break;

      default:
        return jsonError("invalid-action", 400);
    }

    return jsonOK({
      status: "job-updated",
      job_id,
      action,
    });
  } catch (err) {
    console.error("job-lifecycle fatal error:", err);
    return jsonError("job-lifecycle-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Load Job
// ------------------------------------------------------------

async function loadJob(jobId: string) {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("id", jobId)
    .single();
  return data ?? null;
}

// ------------------------------------------------------------
// Lifecycle Actions
// ------------------------------------------------------------

async function markCompleted(job: any, result: any) {
  await updateJob(job.id, {
    state: "completed",
    completed_at: NOW(),
    result,
  });

  await emitEvent(job.run_id, job.step_id, "job.completed");

  // Step lifecycle
  await supabase.functions.invoke("step-lifecycle", {
    body: {
      run_id: job.run_id,
      step_id: job.step_id,
      action: "complete",
      result,
    },
  });

  // Schedule next job
  await supabase.functions.invoke("schedule-next-job", {
    body: { run_id: job.run_id },
  });
}

async function markFailed(job: any, error: any) {
  await updateJob(job.id, {
    state: "failed",
    completed_at: NOW(),
    error,
  });

  await emitEvent(job.run_id, job.step_id, "job.failed");

  await supabase.functions.invoke("step-lifecycle", {
    body: {
      run_id: job.run_id,
      step_id: job.step_id,
      action: "fail",
      error,
    },
  });

  await supabase.functions.invoke("schedule-next-job", {
    body: { run_id: job.run_id },
  });
}

async function markRetry(job: any, error: any) {
  const retryCount = (job.retry_count ?? 0) + 1;

  // Reset straight back to 'pending' (ensure_downstream_job's own
  // convention, same reset repair-stuck-job already does for a stuck
  // job) so glue.dispatch_pending_jobs() picks it up again once its
  // backoff elapses -- 'retrying' as a standalone state had nothing
  // that ever moved a job out of it.
  await updateJob(job.id, {
    state: "pending",
    retry_count: retryCount,
    error,
    claimed_at: null,
    claimed_by: null,
    worker_id: null,
    lease_expires_at: null,
    started_at: null,
    next_attempt_at: new Date(Date.now() + computeBackoffMs(retryCount)).toISOString(),
  });

  await emitEvent(job.run_id, job.step_id, "job.retrying");
}

async function markDelayed(job: any, error: any, delayMs?: number) {
  const ms = typeof delayMs === "number" && delayMs > 0 ? delayMs : 5 * 60_000;

  await updateJob(job.id, {
    state: "pending",
    error,
    claimed_at: null,
    claimed_by: null,
    worker_id: null,
    lease_expires_at: null,
    started_at: null,
    next_attempt_at: new Date(Date.now() + ms).toISOString(),
  });

  await emitEvent(job.run_id, job.step_id, "job.delayed");
}

async function markDeadLetter(job: any, error: any) {
  await updateJob(job.id, {
    state: "dead_letter",
    completed_at: NOW(),
    error,
  });

  await emitEvent(job.run_id, job.step_id, "job.dead_letter");

  await supabase.functions.invoke("step-lifecycle", {
    body: {
      run_id: job.run_id,
      step_id: job.step_id,
      action: "fail",
      error,
    },
  });

  await supabase.functions.invoke("schedule-next-job", {
    body: { run_id: job.run_id },
  });
}

// ------------------------------------------------------------
// Update Helper
// ------------------------------------------------------------

async function updateJob(job_id: string, fields: any) {
  await supabase
    .from("workflow_jobs")
    .update(fields)
    .eq("id", job_id);
}

// ------------------------------------------------------------
// Event Helper
// ------------------------------------------------------------

async function emitEvent(run_id: string, step_id: string, type: string) {
  await supabase.from("workflow_events").insert({
    run_id,
    step_id,
    type,
    created_at: NOW(),
  });
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
